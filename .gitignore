# Entorno virtual
.venv/
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store
.AppleDouble

# Config local del editor (rutas de LaTeX específicas de cada máquina/SO)
.vscode/

# Credenciales
.env

# Carpetas generadas por Anaconda/Jupyter
.virtual_documents/
anaconda_projects/

# Datos pesados: se descargan o se cargan desde Seaborn, no se versionan
data/raw/*
!data/raw/.gitkeep

# Entregables comprimidos y video
*.zip
*.mp4

# Archivos de bloqueo temporal de Microsoft Office (se crean al abrir un .xlsx/.docx)
~$*

# Artefactos de compilación LaTeX en docs/informe_sumativo*/
# (el .tex y el PDF final revisado sí se versionan; esto son solo restos de compilar)
docs/informe_sumativo*/*.aux
docs/informe_sumativo*/*.log
docs/informe_sumativo*/*.out
docs/informe_sumativo*/*.toc
docs/informe_sumativo*/*.synctex.gz
docs/informe_sumativo*/*.fls
docs/informe_sumativo*/*.fdb_latexmk

# Notas sueltas en Markdown (se mantienen los README.md y lo que viva en docs/)
*.md
!**/README.md
!docs/**/*.md
